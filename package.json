  "private": true,
  "description": "Foreman, the eve Software Factory.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "a2a:build": "next build --webpack",
    "a2a:dev": "next dev --webpack",
    "a2a:start": "next start",
