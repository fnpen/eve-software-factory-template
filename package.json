    "@vercel/sandbox": "3.5.0",
    "ai": "^7.0.107",
    "ajv": "^8.20.0",
    "eve": "^0.39.3",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workflow": "5.0.0-beta.56",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "~24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
